---
layout: base.njk
title: Contact
theme: terminal
pageKey: contact
description: Email Riccardo D’Angelo, connect on LinkedIn, or send a message through the contact form.
permalink: /contact/index.html
---
<div class="terminal-page terminal-info terminal-contact">
  {% include "terminal-header.njk" %}
  <main id="main" class="info-main">
    <section class="info-intro" aria-labelledby="contact-title">
      <h1 id="contact-title" class="info-title"><span aria-hidden="true">$</span> Contact</h1>
      <p>Email me directly, connect on LinkedIn, or send a message here.</p>
    </section>
    <div class="contact-layout">
      <section class="contact-channels" aria-labelledby="email-title">
        <h2 id="email-title">Email me directly</h2>
        <button class="contact-submit contact-reveal" type="button" data-email="{{ profile.email | base64 }}" aria-controls="contact-address" hidden>Show email <span aria-hidden="true">→</span></button>
        <a id="contact-address" class="contact-email" hidden></a>
        <p id="contact-fallback" class="contact-help">Use the form or LinkedIn to get in touch.</p>
        <a class="contact-linkedin" href="{{ profile.linkedin }}" target="_blank" rel="noopener noreferrer">Open LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </section>
      <section class="contact-compose" aria-labelledby="message-title">
        <h2 id="message-title">Send a message</h2>
        <p id="contact-required" class="contact-help">All fields are required.</p>
        <form name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="bot-field" aria-labelledby="message-title" aria-describedby="contact-required">
          <input type="hidden" name="form-name" value="contact">
          <p hidden><label>Leave this field empty: <input name="bot-field" type="text" tabindex="-1" autocomplete="off"></label></p>
          <div class="contact-field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="contact-field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="contact-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>
          <button class="contact-submit" type="submit">Send message <span aria-hidden="true">→</span></button>
        </form>
      </section>
    </div>
  </main>
  <nav class="terminal-next" aria-label="Continue reading"><p><span aria-hidden="true">$</span> next</p><a href="/about/">/about <span aria-hidden="true">→</span></a><a href="/cv/">/cv <span aria-hidden="true">→</span></a></nav>
  {% include "terminal-footer.njk" %}
</div>

<script src="/assets/contact.js" defer></script>
